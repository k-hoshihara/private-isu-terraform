#!/bin/bash
set -euxo pipefail

# 3-2「負荷試験の準備」で使用する alp を事前にインストールする。
# nginx のログフォーマットを JSON 形式に変更する作業は書籍の手順に従って手動で行う。
ALP_VERSION="${alp_version}"
WORKDIR="$(mktemp -d)"

# EXIT は終了理由を問わず発火する。正常終了はもちろん、
# ダウンロード失敗時の exit 0 や set -e による異常終了でも一時ディレクトリを削除する。
trap 'rm -rf "$WORKDIR"' EXIT

cd "$WORKDIR"

if ! command -v unzip >/dev/null 2>&1; then
  apt-get update -y
  apt-get install -y unzip
fi

BASE="https://github.com/tkuchiki/alp/releases/download/v$${ALP_VERSION}"

if curl -fsSL -o alp.zip "$${BASE}/alp_linux_amd64.zip"; then
  unzip -o alp.zip
elif curl -fsSL -o alp.tar.gz "$${BASE}/alp_linux_amd64.tar.gz"; then
  tar xzf alp.tar.gz
else
  echo "alp のダウンロードに失敗しました。リリースページでバージョンとファイル名を確認してください。" >&2
  exit 0 # インスタンスの起動自体は失敗させない
fi

install -m 0755 alp /usr/local/bin/alp
/usr/local/bin/alp --version

cd /

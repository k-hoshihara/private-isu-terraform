# =============================================================================
# 当日このファイルを config.env に複製し、値を埋める。
#   cp config.env.example config.env
#
# 埋め方:
#   1. 最初の SSH / SSM で各台に入れる
#   2. docs/common/00200-setup.md の「情報収集」を各台で打つ
#   3. 出力を見ながらここを埋める（docs/common/00200-setup.md）
# 空のままでは動かない項目は、スクリプト起動時にエラーになる。
# =============================================================================

# --- SSH -----------------------------------------------------------------
# 当日: 運営から渡るユーザ名。ほぼ isucon。
# 調べ方: ログイン後に whoami / /home の所有者
SSH_USER=isucon

# 当日: 作業機の秘密鍵。運営配布の鍵、または ssh-keygen したもの。
# 調べ方: ls ~/.ssh/
SSH_KEY=~/.ssh/id_ed25519

# --- サーバ（必要な台数だけ埋める。空の IP は無視される） ---------------
# ROLE は web / app / db / both（複数なら web,app）
# 調べ方: どの台で mysqld が動いているか、どの台でアプリ unit が動いているか
#         docs/common/00200-setup.md の情報収集（サービス / リッスンポート）を見る
#
# 枠は SERVER1..5。埋めるのは持っている台だけ。空の IP はループ側で無視する。
# 練習の既定は 3 台（Terraform webapp_instance_count = 3）。4 と 5 は空のまま。
# 1 台: SERVER1 だけ。2 台: 1 と 2。ISUCON12 本選は 5 台。
# 分割の手順: docs/heavy/multi/00500-multi-server.md
#
# 練習（private-isu 1 台、サーバ上で直接実行）:
#   SERVER1_NAME=local
#   SERVER1_IP=local
#   SERVER1_ROLE=both

SERVER1_NAME=s1
SERVER1_IP=
SERVER1_ROLE=both

SERVER2_NAME=s2
SERVER2_IP=
SERVER2_ROLE=app

SERVER3_NAME=s3
SERVER3_IP=
SERVER3_ROLE=db

SERVER4_NAME=s4
SERVER4_IP=
SERVER4_ROLE=app

SERVER5_NAME=s5
SERVER5_IP=
SERVER5_ROLE=app

# --- アプリ --------------------------------------------------------------
# 当日: systemd の unit 名。回ごとに違う。
# 調べ方: 情報収集のサービス一覧、または
#   systemctl list-unit-files --type=service | grep -Ei 'isu|python|go'
APP_SERVICE=

# 当日: アプリのルート。多くの回は /home/isucon/webapp
# 調べ方: 情報収集の /home/isucon 構成、または unit の WorkingDirectory=
APP_DIR=/home/isucon/webapp

# 当日: Python 実装のディレクトリ。
# 調べ方: APP_DIR 配下の python / python3 / app-python
PYTHON_DIR=/home/isucon/webapp/python

# 当日: アプリが読む環境ファイル。無い回もある。
# 調べ方: /home/isucon/env.sh。unit の EnvironmentFile=
APP_ENV_FILE=/home/isucon/env.sh

# 当日: アプリが listen するポート（nginx の upstream）。
# 調べ方: ss -lntup、または nginx の proxy_pass
APP_PORT=8080

# ヘルスチェック URL。空なら http://127.0.0.1:${APP_PORT}/
HEALTHCHECK_URL=

# デプロイする git ブランチ
DEPLOY_BRANCH=master

# --- DB ------------------------------------------------------------------
# 当日: env.sh やアプリ設定、または mysql の debian.cnf
# 調べ方: grep -i mysql /home/isucon/env.sh
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- ミドルウェア設定ファイル --------------------------------------------
# 調べ方: nginx -t の表示、ls /etc/nginx/sites-enabled /etc/nginx/conf.d
NGINX_CONF=/etc/nginx/nginx.conf
NGINX_SITE_CONF=/etc/nginx/sites-enabled/isucon

# 調べ方: mysql --help | grep 'Default options' のあと、または
#   ls /etc/mysql/mysql.conf.d /etc/mysql/conf.d
MYSQL_CONF=/etc/mysql/mysql.conf.d/mysqld.cnf

# --- ログ ----------------------------------------------------------------
NGINX_ACCESS_LOG=/var/log/nginx/access.log
MYSQL_SLOW_LOG=/var/log/mysql/mysql-slow.log

# --- 計測 ----------------------------------------------------------------
# alp の入力形式。LTSV 投入後は ltsv。
ALP_FORMAT=ltsv
# ソート: sum / avg / count / p95 / p99
ALP_SORT=sum
# マッチャは etc/alp/matching_groups.json（当日、ルーティングを見て埋める）

# py-spy
PYSPY_DURATION=30
# speedscope / svg
PYSPY_FORMAT=speedscope

# ディスク警告の目安（パーセント）。超えたら docs/common/00400-ops.md
DISK_WARN_PERCENT=80

# --- ツールバージョン（空または latest なら GitHub の latest） ----------
ALP_VERSION=latest
SLP_VERSION=latest
OHA_VERSION=latest
INSTALL_NETDATA=1
